SPRING_PROFILE=postgres
SWAGGER_ENABLED=false
# TRACKING_URL=

# La migración Flyway solo se habilita en la API de identidad.
# Los tres procesos deben apuntar a los mismos PostgreSQL y RabbitMQ.

# Orquestador (valores para ejecutar fuera de Docker)
IDENTIDAD_API_URL=http://localhost:8081
ENVIOS_API_URL=http://localhost:8082
RUTAS_API_URL=http://localhost:8083
GATEWAY_CONNECT_TIMEOUT_MS=5000
GATEWAY_REQUEST_TIMEOUT_MS=60000
GATEWAY_BIND_ADDRESS=0.0.0.0
