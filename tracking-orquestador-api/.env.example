DBA_API_KEY=CAMBIAR_SECRETO_DBA
DB_HOST=localhost
# DB_JDBC_URL=
DB_NAME=tracking_psep
DB_PASSWORD=CAMBIAR_EN_LOCAL_Y_PRODUCCION
DB_PORT=5432
# DB_PUERTO=
DB_USER=tracking_psep_user
FLYWAY_ENABLED=true
# HU-13: la usa solo la API de identidad. Al menos 32 caracteres aleatorios: openssl rand -base64 32
IDENTIDAD_CLAVE_MAESTRA=
